# Only PUBLIC values belong here - everything prefixed with VITE_ is visible in the browser.
# Never put secrets (Razorpay key secret, Resend API key, JWT secret) in this file.

# Exact URL of the FitStore server (no trailing slash).
# Local: http://localhost:5050   Production: https://<your-render-service>.onrender.com
VITE_API_URL=http://localhost:5050

# Google OAuth Web Client ID (same value as GOOGLE_CLIENT_ID on the server)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Razorpay TEST key id (public). The server also sends it with each payment.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
