# ---------- Server ----------
# 5050 (not 5000): on macOS 12+ port 5000 is used by the AirPlay Receiver.
PORT=5050
NODE_ENV=development
# The URL where the React app runs (used for CORS and links inside emails)
CLIENT_URL=http://localhost:5173

# ---------- MongoDB Atlas ----------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/fitstore?retryWrites=true&w=majority

# ---------- Google Sign-In ----------
# Same OAuth Web Client ID as VITE_GOOGLE_CLIENT_ID in client/.env
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ---------- JWT session ----------
# Use a long random string (at least 32 characters). Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# ---------- Resend (transactional email) ----------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Must be an address on a domain verified in Resend,
# or "FitStore <onboarding@resend.dev>" for testing (delivers only to your own Resend account email)
RESEND_FROM_EMAIL=FitStore <onboarding@resend.dev>

# ---------- Razorpay (TEST MODE ONLY) ----------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# ---------- Store rules (INR) ----------
SHIPPING_CHARGE=99
FREE_SHIPPING_THRESHOLD=999

# ---------- Deployment ----------
# Number of proxies in front of the API. Leave 0 locally; use 1 on Render.
TRUST_PROXY=0
# Optional. Defaults: "lax" in development, "none" in production (client and API on different domains).
# COOKIE_SAMESITE=
